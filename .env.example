GROQ_API_KEY=replace-me
GROQ_MODEL=openai/gpt-oss-120b
DOMAIN=example.com
COOKIE_SECURE=1
# Optional comma-separated origins when the UI is hosted on a separate domain.
ALLOWED_ORIGINS=
# Anonymous run limits. Enforce the same policy at your edge in production.
RUN_RATE_LIMIT_PER_MINUTE=100
RUN_MAX_CONCURRENT_PER_IP=5
RUN_SUSTAINED_RATE_MINUTES=5
RUN_ABUSE_BLOCK_MINUTES=15
UPLOAD_RATE_LIMIT_PER_MINUTE=10
# Count every provider attempt, including retries, within one run.
MODEL_MAX_ATTEMPTS_PER_RUN=4
# Process-level emergency ceiling; configure a shared provider budget at the edge for multi-instance deployments.
MODEL_DAILY_CALL_LIMIT=10000
MODEL_TIMEOUT_SECONDS=45
# Optional future fallback: challenge clearly abusive traffic at Cloudflare's edge.
# Turnstile is intentionally not part of the application request path.
# Set to 1 only when the origin is protected behind Cloudflare or another trusted proxy.
TRUST_PROXY_HEADERS=0
# Anonymous browser-session runtime lifetime; default is 30 minutes.
SESSION_TTL_SECONDS=1800
